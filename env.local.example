# Copiez ce fichier vers .env.local puis renseignez les valeurs de votre
# projet Supabase (Project Settings > API dans le tableau de bord Supabase).
# Ces deux valeurs sont publiques par conception (clé "anon") : la sécurité
# réelle est assurée par les policies RLS + fonctions SQL, pas par le secret
# de cette clé. Ne mettez jamais la "service_role key" ici.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
